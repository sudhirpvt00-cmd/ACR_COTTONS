# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite default for easy local setup, easily swappable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET=super_secret_jwt_encryption_key_change_in_production_textile_shop
JWT_EXPIRES_IN=7d
COOKIE_NAME=dhanu_auth_token

# OTP Configuration
# Options: 'dev' (logs to console & dev banner), 'msg91', 'twilio'
OTP_PROVIDER=dev
OTP_EXPIRY_MINUTES=5
OTP_RESEND_WAIT_SECONDS=30
OTP_MAX_ATTEMPTS=5

# SMS Provider Stubs (used when OTP_PROVIDER is 'msg91' or 'twilio')
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
